{
    "name": "microweber-packages/microweber-form-builder",
    "description": "Microweber Form Builder – field-type registry and form-definition engine.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://microweber.com",
    "authors": [
        {
            "name": "Bozhidar Slaveykov",
            "email": "bobi@microweber.com"
        },
        {
            "name": "Peter Ivanov",
            "email": "peter@microweber.com"
        },
        {
            "name": "Alexander Raikov",
            "email": "raikov@ymail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "~5.6",
        "illuminate/support": "^11.0|^13.0",
        "microweber-packages/microweber-filament": "*",
        "microweber-packages/microweber-multilanguage": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "MicroweberPackages\\FormBuilder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MicroweberPackages\\FormBuilder\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "replace": {
        "microweber-packages/form-builder": "*"
    }
}
