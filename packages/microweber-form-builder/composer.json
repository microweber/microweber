{
    "name": "microweber-packages/microweber-form-builder",
    "description": "Microweber Form Builder – field-type registry and form-definition engine.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://microweber.com",
    "authors": [
        {
            "name": "Microweber",
            "email": "info@microweber.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "~5.6",
        "illuminate/support": "^11.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "MicroweberPackages\\FormBuilder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MicroweberPackages\\FormBuilder\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "replace": {
        "microweber-packages/form-builder": "*"
    }
}
