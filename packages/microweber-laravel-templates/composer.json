{
    "name": "microweber-packages/microweber-laravel-templates",
    "description": "Microweber CMS.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://microweber.com",
    "authors": [
        {
            "name": "Microweber",
            "email": "info@microweber.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^11.0|^13.0",
        "microweber-packages/microweber-laravel-modules": "*",
        "microweber-packages/microweber-taggable-file-cache": "*",
        "microweber-packages/microweber-config-merge": "*",
        "microweber-packages/microweber-package": "*",
        "nwidart/laravel-modules": "^11.1"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "MicroweberPackages\\LaravelTemplates\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MicroweberPackages\\LaravelTemplates\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "replace": {
        "microweber-packages/laravel-templates": "*"
    }
}
