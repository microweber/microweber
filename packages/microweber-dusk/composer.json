{
    "name": "microweber-packages/microweber-dusk",
    "description": "Microweber Dusk browser test suite — portable across CMS configurations",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/dusk": "^8.0",
        "microweber-packages/microweber-package": "*",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "MicroweberPackages\\Dusk\\": "src/",
            "MicroweberPackages\\Dusk\\Tests\\": "tests/"
        }
    },
    "replace": {
        "microweber/dusk": "*"
    },
    "authors": [
        {
            "name": "Peter Ivanov",
            "email": "peter@microweber.com"
        },
        {
            "name": "Bozhidar Slaveykov",
            "email": "bobi@microweber.com"
        }
    ]
}
