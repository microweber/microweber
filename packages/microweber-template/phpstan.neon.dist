includes:
    - phpstan-baseline.neon

parameters:
    level: 3
    paths:
        - src
    excludePaths:
        - src/tests (?)
        - src/Tests (?)
        - tests (?)
        - Tests (?)
        - src/Adapters/RenderHelpers/ZiggyInlineJsRouteGenerator.php (?)
        - src/Http/Livewire/Admin/AdminTemplateUpdateModal.php (?)
        - src/TemplateInstaller.php (?)
    reportUnmatchedIgnoredErrors: false
