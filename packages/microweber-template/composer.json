{
    "name": "microweber-packages/microweber-template",
    "description": "Microweber CMS.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://microweber.com",
    "authors": [
        {
            "name": "Peter Ivanov",
            "email": "peter@microweber.com"
        },
        {
            "name": "Bozhidar Slaveykov",
            "email": "bobi@microweber.com"
        },
        {
            "name": "Nikolay Rachkov",
            "email": "rachkuw@gmail.com"
        },
        {
            "name": "Alexander Raikov",
            "email": "raikov@ymail.com"
        },
        {
            "name": "Petko Yovchevski",
            "email": "petko@microweber.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/http": "^11.0|^13.0",
        "illuminate/support": "^11.0|^13.0",
        "livewire/livewire": "^4.2",
        "microweber-packages/microweber-template-custom-css": "*",
        "microweber-packages/microweber-format": "*",
        "microweber-packages/microweber-event-manager": "*",
        "microweber-packages/microweber-minifier": "*",
        "microweber-packages/microweber-config": "*",
        "microweber-packages/microweber-install": "*",
        "microweber-packages/microweber-db-installer": "*",
        "microweber-packages/microweber-user": "*",
        "microweber-packages/microweber-meta-tags": "*",
        "microweber-packages/microweber-core": "*",
        "microweber-packages/microweber-admin": "*",
        "microweber-packages/microweber-zip": "*",
        "microweber-packages/microweber-url": "*",
        "microweber-packages/microweber-view": "*",
        "microweber-packages/microweber-laravel-modules": "*",
        "microweber-packages/microweber-laravel-templates": "*",
        "microweber-packages/microweber-template-fonts": "*",
        "microweber-packages/microweber-option": "*",
        "microweber-packages/microweber-app": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "MicroweberPackages\\Template\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MicroweberPackages\\Template\\StandaloneTests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "replace": {
        "microweber-packages/template": "*"
    }
}
