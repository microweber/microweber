{
    "name": "microweber-packages/microweber-console",
    "description": "Microweber CMS.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://microweber.com",
    "authors": [
        {
            "name": "Peter Ivanov",
            "email": "peter@microweber.com"
        },
        {
            "name": "Bozhidar Slaveykov",
            "email": "bobi@microweber.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^11.0|^13.0",
        "illuminate/support": "^11.0|^13.0",
        "microweber-packages/microweber-system-licenses": "*",
        "microweber-packages/microweber-laravel-modules": "*",
        "microweber-packages/microweber-laravel-templates": "*",
        "microweber-packages/microweber-db-installer": "*",
        "microweber-packages/microweber-install": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "MicroweberPackages\\Console\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MicroweberPackages\\Console\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "replace": {
        "microweber-packages/console": "*"
    }
}
