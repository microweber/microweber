{
    "name": "microweber-packages/image-optimization-standalone-validation",
    "description": "Minimal Laravel app validating microweber-image-optimization as a standalone package",
    "type": "project",
    "require": {
        "php": "^8.2",
        "microweber-packages/image-optimization": "@dev",
        "microweber-packages/thumbnailer": "@dev",
        "microweber-packages/media-thumbnail": "@dev",
        "microweber-packages/media-pixum": "@dev",
        "microweber-packages/laravel-helper-functions": "@dev",
        "intervention/image": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "repositories": [
        {"type": "path", "url": "..", "options": {"symlink": true}},
        {"type": "path", "url": "../../microweber-thumbnailer", "options": {"symlink": true}},
        {"type": "path", "url": "../../microweber-media-thumbnail", "options": {"symlink": true}},
        {"type": "path", "url": "../../microweber-media-pixum", "options": {"symlink": true}},
        {"type": "path", "url": "../../laravel-helper-functions", "options": {"symlink": true}},
        {"type": "path", "url": "../../microweber-database", "options": {"symlink": true}},
        {"type": "path", "url": "../../microweber-filesystem", "options": {"symlink": true}}
    ],
    "autoload": {
        "psr-4": {
            "ImageOptimizationStandalone\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ImageOptimizationStandalone\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
