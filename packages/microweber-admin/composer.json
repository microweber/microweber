{
    "name": "microweber-packages/microweber-admin",
    "description": "Microweber CMS.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://microweber.com",
    "authors": [
        {
            "name": "Peter Ivanov",
            "email": "peter@microweber.com"
        },
        {
            "name": "Bozhidar Slaveykov",
            "email": "bobi@microweber.com"
        },
        {
            "name": "Nikolay Rachkov",
            "email": "rachkuw@gmail.com"
        },
        {
            "name": "Alexander Raikov",
            "email": "raikov@ymail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "~5.6",
        "laravel/framework": "^11.0|^13.0",
        "livewire/livewire": "^4.2",
        "microweber-packages/microweber-template": "*",
        "microweber-packages/microweber-user": "*",
        "microweber-packages/microweber-multilanguage": "*",
        "microweber-packages/microweber-livewire-modal": "*",
        "microweber-packages/microweber-install": "*",
        "microweber-packages/microweber-view": "*",
        "microweber-packages/microweber-url": "*",
        "microweber-packages/microweber-filament-registry": "*",
        "microweber-packages/microweber-filament": "*",
        "microweber-packages/microweber-live-edit": "*",
        "microweber-packages/microweber-filament-theme": "*",
        "microweber-packages/microweber-filament-modal-teleport": "*",
        "microweber-packages/microweber-option": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "MicroweberPackages\\Admin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MicroweberPackages\\Admin\\StandaloneTests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "replace": {
        "microweber-packages/admin": "*"
    }
}
