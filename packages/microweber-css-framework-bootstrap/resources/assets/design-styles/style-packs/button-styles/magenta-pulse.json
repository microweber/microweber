{
    "settings": [
        {
            "title": "Button Style: Magenta Pulse",
            "description": "Vivid magenta gradient with a glowing effect and bold white text for a striking look.",
            "fieldType": "stylePack",
            "selectors": [":root"],
            "previewElementsFormat": "flexZoom",
            "previewElements": [
                {"tag": "button", "class": "btn", "label": "Button"},
                {"tag": "button", "class": "btn btn-secondary", "label": "Secondary"},
                {"tag": "button", "class": "btn btn-outline", "label": "Outline"}
            ],
            "rootSelector": ":root",
            "fieldSettings": {
                "styleProperties": [
                    {
                        "label": "Magenta Pulse",
                        "properties": {
                            "--mw-btn-background": "linear-gradient(90deg, #ff5e62 0%, #ff9966 100%)",
                            "--mw-btn-color": "#fff",
                            "--mw-btn-border-size": "2px",
                            "--mw-btn-border-color": "#ff5e62",
                            "--mw-btn-border-radius": "14px",
                            "--mw-btn-font-size": "18px",
                            "--mw-btn-padding-block": "14px",
                            "--mw-btn-padding-inline": "38px",
