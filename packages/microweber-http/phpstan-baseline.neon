parameters:
	ignoreErrors:
		-
			message: '#^Method MicroweberPackages\\Http\\Adapters\\Curl\:\:buildPostString\(\) invoked with 1 parameter, 0 required\.$#'
			identifier: arguments.count
			count: 1
			path: src/Adapters/Curl.php

		-
			message: '#^Method MicroweberPackages\\Http\\Adapters\\Curl\:\:execute\(\) invoked with 1 parameter, 0 required\.$#'
			identifier: arguments.count
			count: 1
			path: src/Adapters/Curl.php

		-
			message: '#^Class MicroweberPackages\\Http\\Adapters\\Guzzle constructor invoked with 1 parameter, 0 required\.$#'
			identifier: arguments.count
			count: 1
			path: src/HttpService.php

		-
			message: '#^PHPDoc tag @var has invalid value \(\)\: Unexpected token "\\n     ", expected type at offset 67 on line 4$#'
			identifier: phpDoc.parseError
			count: 1
			path: src/HttpService.php

		-
			message: '#^PHPDoc tag @var has invalid value \(\)\: Unexpected token "\\n     ", expected type at offset 69 on line 4$#'
			identifier: phpDoc.parseError
			count: 1
			path: src/HttpService.php
