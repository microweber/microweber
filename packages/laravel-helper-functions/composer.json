{
    "name": "microweber-packages/laravel-helper-functions",
    "description": "Helper functions for Microweber",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "MicroweberPackages\\LaravelHelperFunctions\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "MicroweberPackages\\LaravelHelperFunctions\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Peter Ivanov",
            "email": "peter@microweber.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "microweber-packages/microweber-package": "*",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    }
}
