{
    "name": "microweber-packages/microweber-view",
    "description": "Reusable Microweber View package for Laravel: PHP file views, StringBlade rendering, Twig string rendering, and Blade module tag compilation. Usable in standalone Laravel apps.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Peter Ivanov",
            "email": "peter@microweber.com"
        },
        {
            "name": "Bozhidar Slaveykov",
            "email": "bobi@microweber.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^10.0|^11.0|^12.0|^13.0",
        "twig/twig": "^3.0",
        "symfony/http-foundation": "^6.0|^7.0|^8.0",
        "microweber-packages/microweber-package": "*",
        "spatie/laravel-package-tools": "^1.16",
        "microweber-packages/microweber-format": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0",
        "larastan/larastan": "^3.0",
        "microweber-packages/microweber-format": "*"
    },
    "suggest": {
        "microweber-packages/format": "Used by the @module Blade directive for HTML attribute encoding when a CMS parser is present"
    },
    "autoload": {
        "psr-4": {
            "MicroweberPackages\\View\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MicroweberPackages\\View\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M"
    },
    "homepage": "http://microweber.com",
    "support": {
        "email": "support@microweber.com"
    },
    "replace": {
        "microweber-packages/view": "*"
    }
}
