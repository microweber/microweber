{
    "name": "microweber-packages/microweber-filament",
    "description": "Microweber CMS.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://microweber.com",
    "authors": [
        {
            "name": "Microweber",
            "email": "info@microweber.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "~5.6",
        "illuminate/auth": "^11.0|^13.0",
        "illuminate/contracts": "^11.0|^13.0",
        "illuminate/database": "^11.0|^13.0",
        "illuminate/filesystem": "^11.0|^13.0",
        "illuminate/http": "^11.0|^13.0",
        "illuminate/support": "^11.0|^13.0",
        "livewire/livewire": "^4.2",
        "microweber-packages/microweber-meta-tags": "*",
        "microweber-packages/microweber-user": "*",
        "microweber-packages/microweber-multilanguage": "*",
        "microweber-packages/microweber-social-login": "*",
        "microweber-packages/microweber-filament-theme": "*",
        "microweber-packages/microweber-admin": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "MicroweberPackages\\Filament\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MicroweberPackages\\Filament\\StandaloneTests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "replace": {
        "microweber-packages/filament": "*"
    }
}
