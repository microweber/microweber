{
    "name": "microweber-packages/microweber-laravel-modules",
    "description": "Microweber CMS.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://microweber.com",
    "authors": [
        {
            "name": "Peter Ivanov",
            "email": "peter@microweber.com"
        },
        {
            "name": "Bozhidar Slaveykov",
            "email": "bobi@microweber.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "~5.6",
        "laravel/framework": "^11.0|^13.0",
        "livewire/livewire": "^4.2",
        "microweber-packages/microweber-config-merge": "*",
        "microweber-packages/microweber-package": "*",
        "microweber-packages/microweber-taggable-file-cache": "*",
        "microweber-packages/microweber-class-loader": "*",
        "microweber-packages/microweber-laravel-templates": "*",
        "microweber-packages/microweber-filament-registry": "*",
        "microweber-packages/microweber-filament": "*",
        "nwidart/laravel-modules": "^11.1"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "MicroweberPackages\\LaravelModules\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MicroweberPackages\\LaravelModules\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "replace": {
        "microweber-packages/laravel-modules": "*"
    },
    "config": {
        "allow-plugins": {
            "wikimedia/composer-merge-plugin": false
        }
    }
}
