{
    "name": "microweber-packages/env-writer",
    "description": "A standalone .env file writer for Laravel. Reads, updates and appends key-value pairs while preserving comments and preventing duplicate keys.",
    "version": "1.0.0",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "MicroweberPackages\\EnvWriter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MicroweberPackages\\EnvWriter\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Peter Ivanov",
            "email": "peter@microweber.com"
        },
        {
            "name": "Microweber",
            "email": "info@microweber.com"
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "homepage": "http://microweber.com",
    "support": {
        "email": "support@microweber.com"
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    }
}
