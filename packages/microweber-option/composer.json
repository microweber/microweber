{
    "name": "microweber-packages/microweber-option",
    "description": "Microweber CMS.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://microweber.com",
    "authors": [
        {
            "name": "Peter Ivanov",
            "email": "peter@microweber.com"
        },
        {
            "name": "Bozhidar Slaveykov",
            "email": "bobi@microweber.com"
        },
        {
            "name": "Petko Yovchevski",
            "email": "petko@microweber.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^11.0|^13.0",
        "microweber-packages/microweber-database": "*",
        "microweber-packages/microweber-searchable": "*",
        "microweber-packages/microweber-repository": "*",
        "microweber-packages/microweber-url": "*",
        "microweber-packages/microweber-multilanguage": "*",
        "microweber-packages/microweber-core": "*",
        "microweber-packages/microweber-event-manager": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "MicroweberPackages\\Option\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MicroweberPackages\\Option\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "replace": {
        "microweber-packages/option": "*"
    }
}
