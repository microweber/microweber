{
    "name": "microweber-packages/template-fonts",
    "description": "Standalone Laravel package for template font management: Google Fonts, system fonts, custom TTF/WOFF uploads, CSS generation, and Filament admin. Reusable in any Laravel app.",
    "version": "1.0.0",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Microweber Team",
            "email": "info@microweber.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.0",
        "sabberworm/php-css-parser": "^8.4|^9.0",
        "microweber-packages/database": "^1.0",
        "microweber-packages/package": "^1.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "larastan/larastan": "^3.9",
        "livewire/livewire": "^3.0|^4.0",
        "filament/filament": "~5.0",
        "laravel/dusk": "^8.0|^9.0"
    },
    "suggest": {
        "filament/filament": "Required for the Filament admin fonts manager",
        "microweber-packages/http": "Use Microweber HttpClientFactory for secure downloads"
    },
    "autoload": {
        "psr-4": {
            "MicroweberPackages\\TemplateFonts\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "MicroweberPackages\\TemplateFonts\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M"
    },
    "homepage": "http://microweber.com",
    "support": {
        "email": "support@microweber.com"
    }
}
