{
    "name": "microweber-packages/microweber-app",
    "description": "Microweber App.",
    "version": "0.0.1",
    "authors": [
        {
            "name": "Microweber",
            "email": "info@microweber.com"
        },
        {
            "name": "Bozhidar Slaveykov",
            "email": "bobi@microweber.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "~5.6",
        "laravel/framework": "^11.0|^13.0",
        "laravel/sanctum": "^4.0",
        "livewire/livewire": "^4.2"
    },
    "require-dev": [],
    "autoload": {
        "psr-4": {
            "MicroweberPackages\\App\\": "src/"
        },
        "files": [
            "src/functions/api.php",
            "src/functions/laravel.php",
            "src/functions/common.php"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "homepage": "http://microweber.com",
    "license": "MIT",
    "support": {
        "email": "support@microweber.com"
    }
}
