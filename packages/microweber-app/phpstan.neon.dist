includes:
    - phpstan-baseline.neon

parameters:
    level: 3
    paths:
        - src
    excludePaths:
        - src/tests (?)
        - src/Tests (?)
        - tests (?)
        - Tests (?)
        - src/Utils/ParserProcessor.php (?)
        - src/Utils/ParserEditFieldsTrait.php (?)
    reportUnmatchedIgnoredErrors: false
