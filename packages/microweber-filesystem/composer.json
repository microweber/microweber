{
    "name": "microweber-packages/microweber-filesystem",
    "description": "Standalone Laravel filesystem service: file utilities, path normalization, directory operations, extension validation, and SVG sanitization",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Peter Ivanov",
            "email": "peter@microweber.com"
        },
        {
            "name": "Bozhidar Slaveykov",
            "email": "bobi@microweber.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "enshrined/svg-sanitize": "^0.22|^1.0",
        "microweber-packages/microweber-package": "*",
        "spatie/laravel-package-tools": "^1.16",
        "microweber-packages/microweber-file-uploader": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "MicroweberPackages\\Filesystem\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "MicroweberPackages\\Filesystem\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "homepage": "http://microweber.com",
    "support": {
        "email": "support@microweber.com"
    },
    "replace": {
        "microweber-packages/filesystem": "*"
    }
}
