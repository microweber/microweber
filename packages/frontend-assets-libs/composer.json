{
    "name": "microweber-packages/frontend-assets-libs",
    "description": "Library for frontend assets",
    "keywords": [
        "microweber-packages",
        "laravel",
        "microweber-frontend-assets"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "microweber-packages/microweber-package": "*",
        "spatie/laravel-package-tools": "^1.16"
    },
    "autoload": {
        "psr-4": {
            "MicroweberPackages\\FrontendAssetsLibs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MicroweberPackages\\FrontendAssetsLibs\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Peter Ivanov",
            "email": "peter@microweber.com"
        },
        {
            "name": "Bozhidar Slaveykov",
            "email": "bobi@microweber.com"
        }
    ]
}
