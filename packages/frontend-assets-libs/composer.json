{
    "name": "microweber-packages/frontend-assets-libs",
    "description": "Library for frontend assets",
    "keywords": [
        "microweber-packages",
        "laravel",
        "microweber-frontend-assets"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "microweber-packages/package": "^1.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {},
    "autoload": {
        "psr-4": {
            "MicroweberPackages\\FrontendAssetsLibs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MicroweberPackages\\FrontendAssetsLibs\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "version": "1.0.0"
}
