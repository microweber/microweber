{
    "name": "microweber-packages/microweber-multilanguage",
    "description": "Microweber CMS.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://microweber.com",
    "authors": [
        {
            "name": "Microweber",
            "email": "info@microweber.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "~5.6",
        "laravel/framework": "^11.0|^13.0",
        "microweber-packages/microweber-database": "*",
        "microweber-packages/microweber-filament": "*",
        "microweber-packages/microweber-option": "*",
        "microweber-packages/microweber-user": "*",
        "microweber-packages/microweber-translation": "*",
        "microweber-packages/microweber-url": "*",
        "microweber-packages/microweber-repository": "*",
        "microweber-packages/microweber-http": "*",
        "microweber-packages/microweber-form-builder": "*",
        "microweber-packages/microweber-event-manager": "*",
        "microweber-packages/microweber-app": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "MicroweberPackages\\Multilanguage\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MicroweberPackages\\Multilanguage\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "replace": {
        "microweber-packages/multilanguage": "*"
    }
}
