{
    "name": "microweber-packages/microweber-module",
    "description": "Microweber CMS.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://microweber.com",
    "authors": [
        {
            "name": "Peter Ivanov",
            "email": "peter@microweber.com"
        },
        {
            "name": "Bozhidar Slaveykov",
            "email": "bobi@microweber.com"
        },
        {
            "name": "Nikolay Rachkov",
            "email": "rachkuw@gmail.com"
        },
        {
            "name": "Petko Yovchevski",
            "email": "petko@microweber.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "~5.6",
        "laravel/framework": "^11.0|^13.0",
        "livewire/livewire": "^4.2",
        "microweber-packages/microweber-database": "*",
        "microweber-packages/microweber-url": "*",
        "microweber-packages/microweber-admin": "*",
        "microweber-packages/microweber-config-merge": "*",
        "microweber-packages/microweber-filament-registry": "*",
        "microweber-packages/microweber-laravel-modules": "*",
        "microweber-packages/microweber-user": "*",
        "microweber-packages/microweber-repository": "*",
        "microweber-packages/microweber-system-licenses": "*",
        "microweber-packages/microweber-format": "*",
        "microweber-packages/microweber-multilanguage": "*",
        "microweber-packages/microweber-zip": "*",
        "microweber-packages/microweber-app": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "MicroweberPackages\\Module\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MicroweberPackages\\Module\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "replace": {
        "microweber-packages/module": "*"
    }
}
