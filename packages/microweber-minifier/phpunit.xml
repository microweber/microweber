<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../../vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
            <!-- Auth-protected route tests need the CMS User model; run in the monorepo. -->
            <exclude>tests/Feature/MinifierRoutesTest.php</exclude>
            <exclude>tests/Feature/SmokeRoutesTest.php</exclude>
        </testsuite>
        <!-- Filament settings tests need a configured admin panel; run in the monorepo. -->
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
