{
    "name": "microweber-packages/microweber-file-uploader",
    "description": "Standalone Laravel file upload service with MIME validation, size limits, security checks, chunked uploads, and image processing",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Microweber",
            "email": "info@microweber.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/cache": "^10.0|^11.0|^12.0|^13.0",
        "enshrined/svg-sanitize": "^0.22|^1.0",
        "microweber-packages/microweber-package": "*",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "MicroweberPackages\\FileUploader\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MicroweberPackages\\FileUploader\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "homepage": "http://microweber.com",
    "support": {
        "email": "support@microweber.com"
    },
    "replace": {
        "microweber-packages/file-uploader": "*"
    }
}
