{
    "name": "microweber-packages/config-merge",
    "description": "Package-priority config merging for Laravel – lets package/module config values override application defaults instead of the other way around.",
    "version": "1.0.0",
    "type": "library",
    "license": "MIT",
    "homepage": "https://microweber.com",
    "authors": [
        {
            "name": "Microweber",
            "email": "info@microweber.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0||^11.0||^12.0",
        "illuminate/contracts": "^10.0||^11.0||^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0||^9.0||^10.0",
        "phpunit/phpunit": "^10.0||^11.0"
    },
    "autoload": {
        "psr-4": {
            "MicroweberPackages\\ConfigMerge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MicroweberPackages\\ConfigMerge\\Tests\\": "tests/"
        }
    },

    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}