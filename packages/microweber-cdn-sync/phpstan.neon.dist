includes:
    - ../../vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - src
    level: 5
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # HasCdnSync is consumed by the host app's Media model (outside src/), not standalone.
        - '#Trait .+ is used zero times and is not analysed#'
        - '#Function get_option not found#'
        - '#Function save_option not found#'
        - '#Function site_url not found#'
        - '#Function media_uploads_path not found#'
        - '#Function is_admin not found#'
        - '#Function public_asset not found#'