{
    "name": "microweber-packages/package",
    "description": "Standalone Microweber package loader based on spatie/laravel-package-tools. Provides an abstract service provider and optional CMS module registration helpers for use inside the CMS or any Laravel app.",
    "version": "1.0.0",
    "type": "library",
    "license": "MIT",
    "homepage": "https://microweber.com",
    "authors": [
        {
            "name": "Microweber",
            "email": "info@microweber.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "larastan/larastan": "^3.0",
        "phpstan/phpstan": "^2.0"
    },
    "suggest": {
        "microweber-packages/filament-registry": "Enables ModulePackage Filament page/resource/widget/plugin registration",
        "livewire/livewire": "Enables ModulePackage Live Edit / view component registration when the CMS ModuleAdmin facade is present"
    },
    "autoload": {
        "psr-4": {
            "MicroweberPackages\\Package\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MicroweberPackages\\Package\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M -c phpstan.neon.dist"
    },
    "support": {
        "email": "support@microweber.com"
    }
}
