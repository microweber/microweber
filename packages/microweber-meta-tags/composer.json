{
    "name": "microweber-packages/microweber-meta-tags",
    "description": "Microweber CMS – head/footer meta-tag rendering (head tags, scripts, SEO).",
    "type": "library",
    "license": "MIT",
    "homepage": "https://microweber.com",
    "authors": [
        {
            "name": "Peter Ivanov",
            "email": "peter@microweber.com"
        },
        {
            "name": "Alexander Raikov",
            "email": "raikov@ymail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0|^13.0",
        "butschster/meta-tags": "^3.2",
        "microweber-packages/microweber-user": "*",
        "microweber-packages/microweber-template": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "MicroweberPackages\\MetaTags\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MicroweberPackages\\MetaTags\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "replace": {
        "microweber-packages/meta-tags": "*"
    }
}
