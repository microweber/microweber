includes:
    - ../../vendor/larastan/larastan/extension.neon

parameters:
    # Maximized for a green standalone package analysis of src/.
    level: 8
    paths:
        - src
    excludePaths:
        - vendor(?)
        - tests(?)
    tmpDir: build/phpstan
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # Trait is used by CMS module service providers outside this analysis path.
        - '#Trait .+RegistersAiTools is used zero times and is not analysed#'
