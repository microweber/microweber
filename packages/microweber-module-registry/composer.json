{
    "name": "microweber-packages/module-registry",
    "description": "Standalone Microweber module registry for Laravel. Register, discover, render modules and scan blade skins/templates. Usable inside the CMS or any standalone Laravel app.",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "homepage": "https://microweber.com",
    "authors": [
        {
            "name": "Microweber",
            "email": "info@microweber.com"
        },
        {
            "name": "Peter Ivanov",
            "email": "peter@microweber.com"
        },
        {
            "name": "Bozhidar Slaveykov",
            "email": "bobi@microweber.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/view": "^10.0|^11.0|^12.0",
        "microweber-packages/package": "^1.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "livewire/livewire": "^3.0|^4.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "suggest": {
        "livewire/livewire": "Required for the NoSettings Livewire component used as the default module settings UI",
        "microweber-packages/filesystem": "Provides normalize_path() used by blade template scanning",
        "microweber-packages/url": "Provides UrlManager for the optional ManagesUrl trait"
    },
    "autoload": {
        "psr-4": {
            "MicroweberPackages\\ModuleRegistry\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MicroweberPackages\\ModuleRegistry\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M -c phpstan.neon.dist"
    },
    "support": {
        "email": "support@microweber.com"
    }
}
