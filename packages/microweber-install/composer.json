{
    "name": "microweber-packages/microweber-install",
    "description": "Microweber CMS.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://microweber.com",
    "authors": [
        {
            "name": "Peter Ivanov",
            "email": "peter@microweber.com"
        },
        {
            "name": "Bozhidar Slaveykov",
            "email": "bobi@microweber.com"
        },
        {
            "name": "Nikolay Rachkov",
            "email": "rachkuw@gmail.com"
        },
        {
            "name": "Petko Yovchevski",
            "email": "petko@microweber.com"
        },
        {
            "name": "Alexander Raikov",
            "email": "raikov@ymail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^11.0|^13.0",
        "microweber-packages/microweber-option": "*",
        "microweber-packages/microweber-database": "*",
        "microweber-packages/microweber-package-manager-client": "*",
        "microweber-packages/microweber-user": "*",
        "microweber-packages/microweber-http": "*",
        "microweber-packages/microweber-view": "*",
        "microweber-packages/microweber-env-writer": "*",
        "microweber-packages/microweber-system-licenses": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "MicroweberPackages\\Install\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MicroweberPackages\\Install\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "replace": {
        "microweber-packages/install": "*"
    }
}
