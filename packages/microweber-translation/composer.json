{
    "name": "microweber-packages/microweber-translation",
    "description": "Standalone Laravel package for managing translations with database storage, import/export, and locale helpers",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Bozhidar Slaveykov",
            "email": "bobi@microweber.com"
        },
        {
            "name": "Peter Ivanov",
            "email": "peter@microweber.com"
        },
        {
            "name": "phausleitner",
            "email": "108931257+phausleitner@users.noreply.github.com"
        },
        {
            "name": "Nikolay Rachkov",
            "email": "rachkuw@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/translation": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/cache": "^10.0|^11.0|^12.0|^13.0",
        "microweber-packages/microweber-searchable": "*",
        "whitecube/lingua": "^1.1",
        "symfony/intl": "^6.0|^7.0",
        "microweber-packages/microweber-database": "*",
        "microweber-packages/microweber-repository": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "MicroweberPackages\\Translation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MicroweberPackages\\Translation\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "homepage": "http://microweber.com",
    "support": {
        "email": "support@microweber.com"
    },
    "replace": {
        "microweber-packages/translation": "*"
    }
}
