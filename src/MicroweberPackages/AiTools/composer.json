{
    "name": "microweber-packages/ai-tools",
    "description": "AI-powered tool ecosystem for Microweber CMS - Tool calling framework for content, commerce, and external services",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Microweber Team",
            "email": "support@microweber.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "inspector-apm/neuron-ai": "^2.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0"
    },
    "suggest": {
        "microweber/microweber": "For full CMS integration with content and product models",
        "microweber-packages/ai-drivers": "For AI driver abstraction layer"
    },
    "autoload": {
        "psr-4": {
            "MicroweberPackages\\AiTools\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MicroweberPackages\\AiTools\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
