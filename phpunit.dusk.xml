<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         stopOnFailure="false"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerErrors="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         stopOnSkipped="false"
         stopOnRisky="false"
         stopOnIncomplete="false"
         stopOnDeprecation="false"
         failOnEmptyTestSuite="false"
         failOnDeprecation="false"
         failOnIncomplete="false"
         failOnNotice="false"
         failOnRisky="false"
         failOnSkipped="false"
         failOnWarning="false"


>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>


<testsuite name="CoreBrowserTests">
    <directory>src/MicroweberPackages/*/Tests/Browser</directory>
    <exclude>./src/MicroweberPackages/*/</exclude>

  </testsuite>

<testsuite name="Browser">
    <directory>tests/Browser</directory>
</testsuite>

        <testsuite name="LiveEditFullPage">
            <file>tests/Browser/LiveEditFullLandingPageTest.php</file>
        </testsuite>

        <!--
            Live-edit Add Page / Post / Product regression guard for the
            Big2 template. Backstops three chained fixes:
              - task-2026-04-29-dc57b7 (live-edit SAVE submits open
                Filament action),
              - task-2026-04-29-efa1eb (Notification action namespace),
              - task-2026-04-29-ba63de (form requestSubmit flushes
                wire:model bindings before callMountedAction).
        -->
        <testsuite name="LiveEditAddContentBig2">
            <file>tests/Browser/LiveEditAddContentBig2Test.php</file>
        </testsuite>

        <!--
            Posts-list "add post → public render" full pipeline guard
            for task-2026-04-29-76c7f4. Backstops the deeper nesting
            fix from task-2026-04-29-394cd1 — drives the inner
            ContentTableList CreateAction from inside the live-edit
            posts module-settings slideOver, then visits the public
            page and asserts the post title rendered with
            data-limit=1000 paging.
        -->
        <testsuite name="LiveEditPostsListAddPost">
            <file>tests/Browser/LiveEditPostsListAddPostPublicRenderTest.php</file>
        </testsuite>

        <!--
            Comprehensive Post-module admin + public-render coverage
            (task-2026-04-29-4ad513). Visits /admin/post-module-settings
            directly (the URL the live-edit module-settings slideOver
            iframes), drives Create/Edit via mountTableAction, asserts
            persistence + public-page render with data-limit=1000.
        -->
        <testsuite name="PostModuleAdminAndPublicRender">
            <file>tests/Browser/PostModuleAdminAndPublicRenderTest.php</file>
        </testsuite>

        <!--
            Product-module mirror of PostModuleAdminAndPublicRender —
            task-2026-04-29-c7e4f8 (post-list + product-list module
            coverage). Visits /admin/products-module-settings,
            verifies the table loads, drives EditAction via the
            ContentTableList wire, and asserts a `<module
            type="products" data-limit="1000" />` shortcode renders
            seeded products on the public page.
        -->
        <testsuite name="ProductModuleAdminAndPublicRender">
            <file>tests/Browser/ProductModuleAdminAndPublicRenderTest.php</file>
        </testsuite>

        <!--
            Phase-9 CI wiring: groups every LiveEditColorPalette*Test file
            under a single suite so `php artisan dusk` with a testsuite
            argument of LiveEditColorPalettes (or phpunit equivalent)
            runs the palette-specific harness in isolation. Keeps the
            suite independently runnable locally and lets CI parallelize
            it from the broader Browser suite.

            `prefix` + `suffix` on <directory> is the phpunit-native way
            to glob `LiveEditColorPalette*Test.php`. A file-per-test list
            would require a manual edit every time a new palette is
            added under Phase 3's per-palette test growth, which is the
            exact friction Phase 9 is meant to remove.
        -->
        <testsuite name="LiveEditColorPalettes">
            <directory prefix="LiveEditColorPalette" suffix="Test.php">tests/Browser</directory>
        </testsuite>

        <!--
            Regression guard for DuskTestCase::$adminLoggedIn cache bleed.

            The file order matters: PublicPageConsoleClean logs the admin
            session out mid-test (fetch /api/logout + deleteAllCookies).
            If a logout helper forgets to reset the static $adminLoggedIn
            flag, the subsequent FullLandingPage test's loginAsAdmin()
            early-returns on the stale cache and every admin action that
            follows fails on the /login redirect.

            Running this suite in one PHP process exercises that exact
            bleed path; both tests passing back-to-back is the proof.
        -->
        <testsuite name="LiveEditAdminLoginCacheBleedGuard">
            <file>tests/Browser/LiveEditPublicPageConsoleCleanTest.php</file>
            <file>tests/Browser/LiveEditFullLandingPageTest.php</file>
        </testsuite>

        <!--
            Phase-9 bleed guard for the palette apply/save pipeline.

            File order matters: `LiveEditColorPalettePublicRenderTest`
            runs first and, for each of the 17 Bootstrap color packs,
            drives `cssEditor.publishIfChanged()` →
            `/api/current_template_save_custom_css`, persisting the
            final pack as the active template's custom CSS. Left
            unreverted on disk (or in a process-static cache like
            `TemplateCustomCss`'s in-memory map, or the options-cache
            bucket for the custom-CSS URL), those writes would bleed
            into any subsequent live-edit test — the next run would
            open live-edit with the last palette already painted on
            :root, and `LiveEditColorPaletteSwitchNoBleedTest`'s A→B
            apply-and-assert flow would see B's expected values masked
            by the residual C from the prior test.

            Running these two files back-to-back in one PHP process
            exercises that exact bleed path. Both tests passing is the
            proof that the Public-Render teardown (or the factory's
            per-page custom-CSS scoping, or the Switch-No-Bleed
            clickPalette() driver itself) absorbs the static state and
            doesn't let it leak across the boundary.

            Matches the shape of `LiveEditAdminLoginCacheBleedGuard`
            above — a narrow ordered pair, not a general suite.
        -->
        <testsuite name="LiveEditColorPaletteSwitchNoBleedGuard">
            <file>tests/Browser/LiveEditColorPalettePublicRenderTest.php</file>
            <file>tests/Browser/LiveEditColorPaletteSwitchNoBleedTest.php</file>
        </testsuite>

        <testsuite name="ModulesBrowserTests">
            <directory>Modules/*/Tests/Browser</directory>

        </testsuite>

        <testsuite name="TemplatesBrowserTests">
            <directory>Templates/*/Tests/Browser</directory>
        </testsuite>

    </testsuites>
    <source>
        <include>
            <directory>app</directory>
            <directory>src</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="SESSION_DRIVER" value="array"/>
        <ini name="memory_limit" value="-1"/>
        <env name="MAIL_DRIVER" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="SYMFONY_DEPRECATIONS_HELPER" value="weak"/>
        <ini name="display_errors" value="On"/>
        <ini name="display_startup_errors" value="On"/>

    </php>


</phpunit>
