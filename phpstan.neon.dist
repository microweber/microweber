includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5
    paths:
        - app
        - src
        - Modules
        - tests
    excludePaths:
        - vendor(?)
        - node_modules(?)
        - bootstrap/cache(?)
        - storage(?)
        - packages/*/vendor(?)
        - packages/*/node_modules(?)
        - resources/views(?)
        - '**/Pest.php'
    tmpDir: build/phpstan
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # Filament v5 migration allowances
        - '#Call to deprecated method#'
        - '#Access to deprecated property#'
        # Blade template variables are passed at runtime
        -
            message: '#Variable \$\w+ might not be defined#'
            paths:
                - Modules/*/resources/views/*
        # Module view namespaces (modules.*::) are valid but not recognized by Larastan
        - '#expects view-string\|null, string given#'
