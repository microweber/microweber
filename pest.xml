<?xml version="1.0" encoding="UTF-8"?>
<pest>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
            <directory>Modules/*/Tests/Unit</directory>
            <directory>Modules/*/tests/Unit</directory>
            <directory>src/MicroweberPackages/*/tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
            <directory>Modules/*/Tests/Feature</directory>
            <directory>Modules/*/tests/Feature</directory>
            <directory>src/MicroweberPackages/*/tests/Feature</directory>
        </testsuite>
        <testsuite name="Modules">
            <directory>Modules/*/Tests</directory>
            <directory>Modules/*/tests</directory>
        </testsuite>
        <testsuite name="Packages">
            <directory>src/MicroweberPackages/*/tests</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>app</directory>
            <directory>src</directory>
            <directory>Modules</directory>
        </include>
        <exclude>
            <directory>vendor</directory>
            <directory>storage</directory>
            <directory>bootstrap/cache</directory>
        </exclude>
    </source>

    <coverage>
        <include>
            <directory>app</directory>
            <directory>src</directory>
            <directory>Modules</directory>
        </include>
        <exclude>
            <directory>vendor</directory>
            <directory>storage</directory>
            <directory>config</directory>
            <directory>database</directory>
            <directory>resources</directory>
            <directory>routes</directory>
        </exclude>
    </coverage>

    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="SESSION_DRIVER" value="array"/>
        <ini name="memory_limit" value="-1"/>
        <env name="MAIL_DRIVER" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="SYMFONY_DEPRECATIONS_HELPER" value="weak"/>
        <ini name="display_errors" value="On"/>
        <ini name="display_startup_errors" value="On"/>
    </php>
</pest>
