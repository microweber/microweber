        "microweber-packages/frontend-assets-libs": "*",
        "microweber-packages/laravel-helper-functions": "*",
        "microweber-packages/microweber-filament-theme": "*",
        "microweber-packages/laravel-config-extended": "*",
        "intervention/image-laravel": "^1.4",
        "tapp/filament-timezone-field": "*",
        "league/flysystem-bundle": "^3.4",
        "league/flysystem-aws-s3-v3": "^3.368",
        "barryvdh/laravel-dompdf": "*",
        "darkaonline/l5-swagger": "9.0.1",
        "dutchcodingcompany/filament-socialite": "~3.0",
        "openai-php/client": "^0.12.0",
