{
    "name": "microweber/microweber",
    "type": "application",
    "description": "New generation CMS with drag and drop",
    "keywords": [
        "cms",
        "drag and drop",
        "shop",
        "blog",
        "framework",
        "laravel",
        "php",
        "ecommerce",
        "website",
        "builder",
        "microweber",
        "filament"
