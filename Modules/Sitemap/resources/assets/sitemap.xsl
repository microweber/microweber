<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0"
    xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
    xmlns:sitemap="http://www.sitemaps.org/schemas/sitemap/0.9"
    xmlns:image="http://www.google.com/schemas/sitemap-image/1.1"
    xmlns:xhtml="http://www.w3.org/1999/xhtml"
    xmlns:mw="http://microweber.com/schemas/sitemap-ext/1.0">
    <!--
      Styled XML sitemap stylesheet for the Microweber Sitemap module.
      Rendered by the browser only (via the <?xml-stylesheet?> processing
      instruction the controller injects); search-engine crawlers ignore it,
      so the underlying XML stays a valid sitemap. XSLT 1.0 on purpose: it is
      the only version browsers support natively. Every node is matched on the
      `sitemap:` prefix because <urlset>/<sitemapindex> live in the
      sitemaps.org/0.9 namespace — an unprefixed match renders a blank page.
    -->
    <xsl:output method="html" encoding="UTF-8" indent="yes"
        doctype-system="about:legacy-compat"/>

    <xsl:template match="/">
        <html lang="en">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <meta name="robots" content="noindex, follow"/>
                <title>XML Sitemap</title>
                <style type="text/css">
                    :root { --mw-blue: #0d6efd; --mw-ink: #182433; --mw-line: #e8eef4; --mw-muted: #6b7280; }
                    * { box-sizing: border-box; }
                    body { margin: 0; background: #f6f8fb; color: var(--mw-ink);
                        font: 14px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
                    .wrap { max-width: 1040px; margin: 0 auto; padding: 32px 16px 64px; }
                    header h1 { font-size: 22px; margin: 0 0 4px; letter-spacing: -0.01em; }
                    header p { margin: 0; color: var(--mw-muted); font-size: 13px; }
                    header a { color: var(--mw-blue); text-decoration: none; }
                    header a:hover { text-decoration: underline; }
                    .count { margin: 20px 0 10px; color: var(--mw-muted); font-size: 13px; }
                    .card { background: #fff; border: 1px solid var(--mw-line); border-radius: 8px;
                        box-shadow: 0 1px 3px rgba(24,36,51,.04); overflow: hidden; }
                    table { width: 100%; border-collapse: collapse; }
                    th { text-align: left; font-size: 10px; letter-spacing: .4px; text-transform: uppercase;
                        color: var(--mw-muted); font-weight: 600; padding: 14px 16px; background: #fbfcfe;
                        border-bottom: 1px solid var(--mw-line); }
                    td { padding: 12px 16px; border-bottom: 1px solid var(--mw-line); font-size: 13px;
                        vertical-align: top; }
                    tr:last-child td { border-bottom: 0; }
                    tbody tr:hover { background: #f6f9ff; }
                    td a { color: var(--mw-blue); text-decoration: none; word-break: break-all; }
                    td a:hover { text-decoration: underline; }
                    .num { color: var(--mw-muted); text-align: right; white-space: nowrap; }
                    .date { color: var(--mw-muted); white-space: nowrap; }
                    .urlcell { display: flex; gap: 12px; align-items: flex-start; }
                    .thumb { width: 44px; height: 44px; flex: 0 0 44px; border-radius: 6px;
                        object-fit: cover; border: 1px solid var(--mw-line); background: #fff; }
                    .meta { margin-top: 5px; display: flex; flex-wrap: wrap; gap: 6px 10px;
                        align-items: center; font-size: 12px; }
                    .price { font-weight: 600; color: #0a7d33; }
                    .pills { color: var(--mw-muted); }
                    .pill { display: inline-block; background: #eef3fb; color: #35486a;
                        border-radius: 999px; padding: 1px 8px; margin-right: 4px; font-size: 11px; }
                    @media (max-width: 600px) {
                        .hide-sm { display: none; }
                        .wrap { padding: 20px 12px 48px; }
                    }
                </style>
            </head>
            <body>
                <div class="wrap">
                    <header>
                        <h1>XML Sitemap</h1>
                        <p>Generated by Microweber. This page is for people — search engines read the
                           raw <a href="https://www.sitemaps.org/protocol.html">XML</a>.</p>
                    </header>

                    <!-- Sitemap INDEX (a list of child sitemaps) -->
                    <xsl:if test="count(sitemap:sitemapindex/sitemap:sitemap) &gt; 0">
                        <p class="count">
                            This index links to
                            <strong><xsl:value-of select="count(sitemap:sitemapindex/sitemap:sitemap)"/></strong>
                            sitemaps.
                        </p>
                        <div class="card">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Sitemap</th>
                                        <th class="date hide-sm">Last modified</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <xsl:for-each select="sitemap:sitemapindex/sitemap:sitemap">
                                        <tr>
                                            <td>
                                                <a href="{sitemap:loc}"><xsl:value-of select="sitemap:loc"/></a>
                                            </td>
                                            <td class="date hide-sm">
                                                <xsl:choose>
                                                    <xsl:when test="sitemap:lastmod">
                                                        <xsl:value-of select="substring(sitemap:lastmod, 1, 10)"/>
                                                    </xsl:when>
                                                    <xsl:otherwise>&#8212;</xsl:otherwise>
                                                </xsl:choose>
                                            </td>
                                        </tr>
                                    </xsl:for-each>
                                </tbody>
                            </table>
                        </div>
                    </xsl:if>

                    <!-- URL set (a leaf sitemap of page URLs) -->
                    <xsl:if test="count(sitemap:urlset/sitemap:url) &gt; 0">
                        <p class="count">
                            This sitemap contains
                            <strong><xsl:value-of select="count(sitemap:urlset/sitemap:url)"/></strong>
                            URLs.
                        </p>
                        <div class="card">
                            <table>
                                <thead>
                                    <tr>
                                        <th>URL</th>
                                        <th class="num hide-sm">Images</th>
                                        <th class="date hide-sm">Last modified</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <xsl:for-each select="sitemap:urlset/sitemap:url">
                                        <tr>
                                            <td>
                                                <div class="urlcell">
                                                    <xsl:if test="image:image/image:loc">
                                                        <img class="thumb" alt="" loading="lazy"
                                                            src="{image:image[1]/image:loc}"/>
                                                    </xsl:if>
                                                    <div>
                                                        <a href="{sitemap:loc}"><xsl:value-of select="sitemap:loc"/></a>
                                                        <xsl:if test="mw:price or mw:category or mw:tag">
                                                            <div class="meta">
                                                                <xsl:if test="mw:price">
                                                                    <span class="price"><xsl:value-of select="mw:price"/></span>
                                                                </xsl:if>
                                                                <xsl:if test="mw:category">
                                                                    <span class="pills">
                                                                        <xsl:for-each select="mw:category">
                                                                            <span class="pill"><xsl:value-of select="."/></span>
                                                                        </xsl:for-each>
                                                                    </span>
                                                                </xsl:if>
                                                                <xsl:if test="mw:tag">
                                                                    <span class="pills">
                                                                        <xsl:for-each select="mw:tag">
                                                                            <span class="pill">#<xsl:value-of select="."/></span>
                                                                        </xsl:for-each>
                                                                    </span>
                                                                </xsl:if>
                                                            </div>
                                                        </xsl:if>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="num hide-sm">
                                                <xsl:value-of select="count(image:image)"/>
                                            </td>
                                            <td class="date hide-sm">
                                                <xsl:choose>
                                                    <xsl:when test="sitemap:lastmod">
                                                        <xsl:value-of select="substring(sitemap:lastmod, 1, 10)"/>
                                                    </xsl:when>
                                                    <xsl:otherwise>&#8212;</xsl:otherwise>
                                                </xsl:choose>
                                            </td>
                                        </tr>
                                    </xsl:for-each>
                                </tbody>
                            </table>
                        </div>
                    </xsl:if>
                </div>
            </body>
        </html>
    </xsl:template>
</xsl:stylesheet>
