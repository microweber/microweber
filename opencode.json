{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "allow"
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "enabled": true,
      "environment": {
        "MEMORY_FILE_PATH": ".autodev/MEMORY.md"
      }
    },
    "computer-use-mcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "computer-use-mcp"
      ],
      "enabled": true
    },
    "mcp-atlassian": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-atlassian"
      ],
      "enabled": true,
      "environment": {
        "JIRA_URL": "https://microweber.atlassian.net",
        "JIRA_USERNAME": "boksiora@gmail.com",
        "JIRA_API_TOKEN": "ATATT3xFfGF0_jbNUUtrGbkISn0lZoS6HuEt2eCEalappGnryR76OpsiNx9dTkEIZp5dPwz-LWDY90Do8xIu__tfEiB-dSxXoOINQvAzDVtxhfNG93xtyMCXSSd-lMHu56qexxvpA7a3DLnw00UscWh333e8-7QVQGLxcllyNnsMgTxYv8_z1Sc=F50C02BF"
      }
    },
    "zerolib-email": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-email-server@latest",
        "stdio"
      ],
      "enabled": true,
      "environment": {
        "MCP_EMAIL_SERVER_ACCOUNT_NAME": "default",
        "MCP_EMAIL_SERVER_EMAIL_ADDRESS": "agent-a1@emailpwd.com",
        "MCP_EMAIL_SERVER_PASSWORD": "rkOIaiZ479iBzqMweEKp",
        "MCP_EMAIL_SERVER_IMAP_HOST": "mail.emailpwd.com",
