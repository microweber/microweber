# Microweber Docker Environment Configuration
# Copy this file to .env and customize as needed

# Application
APP_NAME=Microweber
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Localization
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Security
BCRYPT_ROUNDS=12

# Database (MySQL)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=microweber
DB_USERNAME=microweber
DB_PASSWORD=secret

# Alternative: SQLite (for simple development)
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# Session
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cache
CACHE_STORE=redis
CACHE_PREFIX=mw_cache_

# Queue
QUEUE_CONNECTION=database
DB_QUEUE_TABLE=jobs
QUEUE_FAILED_DRIVER=database-uuids

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3

# Mail (Mailpit for development)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 (MinIO for local development)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=microweber
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# File Upload Configuration
MW_UPLOAD_LIMIT_IMAGES=10240
MW_UPLOAD_LIMIT_VIDEOS=102400
MW_UPLOAD_LIMIT_AUDIOS=51200
MW_UPLOAD_LIMIT_DOCUMENTS=20480
MW_UPLOAD_LIMIT_ARCHIVES=102400
MW_UPLOAD_LIMIT_DEFAULT=10240
MW_UPLOAD_VALIDATE_MIME=true
MW_UPLOAD_VALIDATE_EXTENSION=true
MW_UPLOAD_BLOCK_DANGEROUS=true
MW_UPLOAD_SCAN_SVG=true
MW_UPLOAD_STRIP_EXIF=true
MW_UPLOAD_MAX_PER_HOUR=100
MW_UPLOAD_ALLOW_PHP=false

# Page Cache
PAGE_CACHE_ENABLED=false
PAGE_CACHE_TTL=3600
PAGE_CACHE_DRIVER=redis
PAGE_CACHE_LOGGED_IN=false
PAGE_CACHE_QUERY_PARAMS=false
PAGE_CACHE_MOBILE=true

# Fragment Cache
FRAGMENT_CACHE_ENABLED=true
FRAGMENT_CACHE_TTL=3600
FRAGMENT_CACHE_DRIVER=redis

# Asset Optimization
ASSET_OPTIMIZATION_ENABLED=false
ASSET_USE_CDN=false
ASSET_CDN_URL=
ASSET_MINIFY_CSS=false
ASSET_MINIFY_JS=false
ASSET_VERSIONING=false

# Image Optimization
MW_WEBP_ENABLED=true
MW_WEBP_QUALITY=85
MW_LAZY_LOADING_ENABLED=true
MW_WEBP_AUTO_CONVERT=false
MW_WEBP_CACHE=true
MW_WEBP_CACHE_TTL=604800

# OAuth Configuration (Development - leave empty to disable)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=/oauth/callback/facebook

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=/oauth/callback/google

# Payment Gateways (Development - leave empty to disable)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_TEST_MODE=true

# Vite
VITE_APP_NAME="${APP_NAME}"
