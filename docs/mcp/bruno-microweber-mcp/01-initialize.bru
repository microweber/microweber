meta {
  name: 01 initialize (handshake)
  type: http
  seq: 1
}

post {
  url: {{base_url}}{{mcp_path}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearer_token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "initialize",
    "params": {
      "protocolVersion": "2025-03-26",
      "clientInfo": {
        "name": "microweber-mcp-bruno",
        "version": "1.0.0"
      }
    }
  }
}
