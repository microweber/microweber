<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         stopOnFailure="false"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerErrors="true"
         displayDetailsOnTestsThatTriggerNotices="false"
         enforceTimeLimit="false"
         stopOnSkipped="false"
         stopOnRisky="false"
         stopOnIncomplete="false"
         stopOnDeprecation="false"
         failOnEmptyTestSuite="false"
         failOnDeprecation="false"
         failOnIncomplete="false"
         failOnNotice="false"
         failOnRisky="false"
         failOnSkipped="false"
         failOnWarning="false"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>

    <testsuite name="Feature">
      <directory>tests/Feature</directory>
      <exclude>tests/Feature/Filament/AuthorizationTest.php</exclude>
    </testsuite>

    <testsuite name="GlobalSearch">
      <directory>tests/Feature/Filament/GlobalSearch</directory>
      <directory>tests/Feature/Filament/Resources</directory>
    </testsuite>

        <testsuite name="Core">
            <exclude>src/MicroweberPackages/*/Tests/Browser</exclude>
            <exclude>src/MicroweberPackages/*/tests/Browser</exclude>
            <exclude>src/MicroweberPackages/FormBuilder/Tests</exclude>
            <directory>./src/MicroweberPackages/*/</directory>
        </testsuite>

        <!--
            Module tests are split into groups to prevent OOM errors.
            PHP leaks ~6MB/test from internal memory fragmentation that
            cannot be GC'd. Filament/Livewire tests use
            RunTestsInSeparateProcesses to run each test method in its
            own PHP process, preventing memory accumulation.
            Use ./run-tests.sh to run all groups in separate processes.
        -->

        <!-- Newsletter -->
        <testsuite name="Modules-Newsletter">
            <directory>Modules/Newsletter/Tests</directory>
        </testsuite>

        <!-- Content + ContentData -->
        <testsuite name="Modules-Content">
            <directory>Modules/Content/Tests</directory>
            <directory>Modules/ContentData/Tests</directory>
            <directory>Modules/ContentDataVariant/Tests</directory>
        </testsuite>

        <!-- Billing -->
        <testsuite name="Modules-Billing">
            <directory>Modules/Billing/Tests</directory>
        </testsuite>

        <!-- Group 3: Components + Comments + Cart + Category + Coupons -->
        <testsuite name="Modules-Group3">
            <exclude>Modules/*/Tests/Browser</exclude>
            <directory>Modules/Components/Tests</directory>
            <directory>Modules/Comments/Tests</directory>
            <directory>Modules/Cart/Tests</directory>
            <directory>Modules/Category/Tests</directory>
            <directory>Modules/Coupons/Tests</directory>
        </testsuite>

        <!-- Group 4: Product + Order + Customer + Tag + Payment + Shipping -->
        <testsuite name="Modules-Group4">
            <exclude>Modules/*/Tests/Browser</exclude>
            <directory>Modules/Product/Tests</directory>
            <directory>Modules/Order/Tests</directory>
            <directory>Modules/Customer/Tests</directory>
            <directory>Modules/Tag/Tests</directory>
            <directory>Modules/Payment/Tests</directory>
            <directory>Modules/Shipping/Tests</directory>
        </testsuite>

        <!-- Group 5: Invoice + Form + Offer + Backup + CustomFields + Shop + Rating + Page + Faq + Profile + Post + Settings -->
        <testsuite name="Modules-Group5">
            <exclude>Modules/*/Tests/Browser</exclude>
            <directory>Modules/Invoice/Tests</directory>
            <directory>Modules/Form/Tests</directory>
            <directory>Modules/Offer/Tests</directory>
            <directory>Modules/Backup/Tests</directory>
            <directory>Modules/CustomFields/Tests</directory>
            <directory>Modules/Shop/Tests</directory>
            <directory>Modules/Rating/Tests</directory>
            <directory>Modules/Page/Tests</directory>
            <directory>Modules/Faq/Tests</directory>
            <directory>Modules/Profile/Tests</directory>
            <directory>Modules/Post/Tests</directory>
            <directory>Modules/Settings/Tests</directory>
        </testsuite>

        <!-- Group 6A: Larger small modules -->
        <testsuite name="Modules-Group6A">
            <exclude>Modules/*/Tests/Browser</exclude>
            <directory>Modules/Video/Tests</directory>
            <directory>Modules/MailTemplate/Tests</directory>
            <directory>Modules/Sitemap/Tests</directory>
            <directory>Modules/Menu/Tests</directory>
            <directory>Modules/Media/Tests</directory>
            <directory>Modules/MediaLibrary/Tests</directory>
            <directory>Modules/Teamcard/Tests</directory>
            <directory>Modules/Restore/Tests</directory>
            <directory>Modules/ImageRollover/Tests</directory>
            <directory>Modules/Checkout/Tests</directory>
            <directory>Modules/Attributes/Tests</directory>
            <directory>Modules/AiWizard/Tests</directory>
            <directory>Modules/Ai/Tests</directory>
            <directory>Modules/SiteStats/Tests</directory>
            <directory>Modules/Marketplace/Tests</directory>
            <directory>Modules/FileManager/Tests</directory>
        </testsuite>

        <!-- Group 6B: Smaller modules -->
        <testsuite name="Modules-Group6B">
            <exclude>Modules/*/Tests/Browser</exclude>
            <directory>Modules/Tax/Tests</directory>
            <directory>Modules/Tabs/Tests</directory>
            <directory>Modules/GoogleAnalytics/Tests</directory>
            <directory>Modules/Country/Tests</directory>
            <directory>Modules/RssFeed/tests</directory>
            <directory>Modules/Log/Tests</directory>
            <directory>Modules/Export/Tests</directory>
            <directory>Modules/Btn/Tests</directory>
            <directory>Modules/Accordion/Tests</directory>
            <directory>Modules/Address/Tests</directory>
            <directory>Modules/Audio/Tests</directory>
            <directory>Modules/Background/Tests</directory>
            <directory>Modules/BeforeAfter/Tests</directory>
            <directory>Modules/Blog/Tests</directory>
            <directory>Modules/Captcha/Tests</directory>
            <directory>Modules/Cloudflare/Tests</directory>
            <directory>Modules/CookieNotice/Tests</directory>
            <directory>Modules/Currency/Tests</directory>
            <directory>Modules/Embed/Tests</directory>
            <directory>Modules/FacebookLike/Tests</directory>
            <directory>Modules/FacebookPage/Tests</directory>
            <directory>Modules/GoogleMaps/Tests</directory>
            <directory>Modules/HighlightCode/Tests</directory>
            <directory>Modules/Logo/Tests</directory>
            <directory>Modules/Marquee/Tests</directory>
            <directory>Modules/OpenApi/Tests</directory>
            <directory>Modules/Pdf/Tests</directory>
            <directory>Modules/Pictures/Tests</directory>
            <directory>Modules/Sharer/Tests</directory>
            <directory>Modules/Skills/Tests</directory>
            <directory>Modules/Slider/Tests</directory>
            <directory>Modules/SocialLinks/Tests</directory>
            <directory>Modules/Testimonials/Tests</directory>
            <directory>Modules/TextType/Tests</directory>
            <directory>Modules/TweetEmbed/Tests</directory>
        </testsuite>

        <testsuite name="Modules-WordPressMigration">
            <directory>Modules/WordPressMigration/Tests</directory>
        </testsuite>

        <testsuite name="FormBuilder">
            <directory>src/MicroweberPackages/FormBuilder/Tests</directory>
        </testsuite>

        <testsuite name="MicroweberUrl">
            <directory>packages/microweber-url/tests</directory>
            <exclude>packages/microweber-url/tests/UrlManagerIntegratedTest.php</exclude>
        </testsuite>

        <testsuite name="MicroweberCore">
            <directory>packages/microweber-core/tests</directory>
        </testsuite>

        <testsuite name="MicroweberAiTools">
            <directory>packages/microweber-ai-tools/tests</directory>
            <exclude>packages/microweber-ai-tools/tests/Dusk</exclude>
        </testsuite>

        <testsuite name="MicroweberCdnSync">
            <directory>packages/microweber-cdn-sync/tests</directory>
        </testsuite>

        <testsuite name="MicroweberImageOptimization">
            <directory>packages/microweber-image-optimization/tests</directory>
            <exclude>packages/microweber-image-optimization/tests/Dusk</exclude>
        </testsuite>

        <testsuite name="MicroweberMinifier">
            <directory>packages/microweber-minifier/tests</directory>
            <exclude>packages/microweber-minifier/tests/Dusk</exclude>
        </testsuite>

        <testsuite name="MicroweberClassLoader">
            <directory>packages/microweber-class-loader/tests</directory>
        </testsuite>

        <testsuite name="MicroweberQueue">
            <directory>packages/microweber-queue/tests</directory>
            <exclude>packages/microweber-queue/tests/Dusk</exclude>
        </testsuite>

        <testsuite name="MicroweberMailSender">
            <directory>packages/microweber-mail-sender/tests</directory>
        </testsuite>

        <testsuite name="MicroweberNotification">
            <directory>packages/microweber-notification/tests</directory>
            <exclude>packages/microweber-notification/tests/Dusk</exclude>
        </testsuite>

        <testsuite name="MicroweberTemplateFonts">
            <directory>packages/microweber-template-fonts/tests</directory>
            <exclude>packages/microweber-template-fonts/tests/Dusk</exclude>
        </testsuite>

        <testsuite name="MicroweberTemplateCustomCss">
            <directory>packages/microweber-template-custom-css/tests</directory>
            <exclude>packages/microweber-template-custom-css/tests/Dusk</exclude>
        </testsuite>

        <testsuite name="Packages-View">
            <directory>packages/microweber-view/tests</directory>
        </testsuite>

        <testsuite name="Packages-Zip">
            <directory>packages/microweber-zip/tests</directory>
        </testsuite>

        <testsuite name="MicroweberPackageManagerClient">
            <directory>packages/microweber-package-manager-client/tests</directory>
            <exclude>packages/microweber-package-manager-client/tests/Browser</exclude>
        </testsuite>

        <testsuite name="MicroweberDbExport">
            <directory>packages/microweber-db-export/tests</directory>
        </testsuite>

        <testsuite name="MicroweberDatabase">
            <directory>packages/microweber-database/src/tests</directory>
        </testsuite>

        <testsuite name="MicroweberSecurity">
            <directory>packages/microweber-security/tests</directory>
            <!-- HtmlClean admin_mode paths are covered by package phpunit config and
                 standalone-validation; monorepo suite can hang on recursive sanitizer. -->
            <exclude>packages/microweber-security/tests/HtmlCleanTest.php</exclude>
            <!-- CMS-boot provider tests live under tests/Unit (SecurityAndUrlPackageIntegrationTest). -->
            <exclude>packages/microweber-security/tests/SecurityServiceProviderTest.php</exclude>
            <exclude>packages/microweber-security/tests/TestCase.php</exclude>
        </testsuite>

        <testsuite name="MicroweberEventManager">
            <directory>packages/microweber-event-manager/tests/Cms</directory>
        </testsuite>

        <testsuite name="Templates">
            <exclude>Templates/*/Tests/Browser</exclude>
            <!--
                Templates/Big2/Tests/Unit/LayoutsRenderTest.php ships from
                upstream without a setUp() that activates the Big2 template,
                so it asserts against Bootstrap's skin-1 (no inner btn module)
                and always fails. The tracked canonical version lives at
                tests/Unit/Template/Big2LayoutsRenderTest.php, activates Big2
                in setUp(), and markTestSkipped() when Big2 isn't installed.
                Exclude the upstream copy here so installs that have Big2
                still get coverage via the tracked test without the duplicate
                failure / state-leak conflict between the two tests.
            -->
            <exclude>Templates/Big2/Tests/Unit/LayoutsRenderTest.php</exclude>
            <directory>Templates/*/Tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
            <directory>src</directory>
            <directory>Modules</directory>
            <!-- Extracted packages must be project sources so PHPUnit 11 deprecation
                 analysis does not hang on HtmlSanitizer / security / url code. -->
            <directory>packages/microweber-security/src</directory>
            <directory>packages/microweber-url/src</directory>
            <directory>packages/microweber-format/src</directory>
            <directory>packages/microweber-view/src</directory>
            <directory>packages/laravel-helper-functions/src</directory>
        </include>
        <exclude>
            <directory>vendor</directory>
            <directory>storage</directory>
            <directory>config</directory>
            <directory>database</directory>
            <directory>resources</directory>
            <directory>routes</directory>
        </exclude>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
    </php>
</phpunit>
