# ============================================
# Microweber CMS - Production Environment Configuration
# ============================================
# This file contains production-ready settings for production deployment
# Copy this to .env and customize for your production environment
# WARNING: Never commit actual credentials to version control!

# ============================================
# Application Settings
# ============================================
APP_NAME="Microweber"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.com
APP_KEY=

# ============================================
# Database Configuration
# ============================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=microweber
DB_USERNAME=microweber
DB_PASSWORD=

# Database Performance
DB_POOL_ENABLED=true
DB_POOL_MIN_CONNECTIONS=5
DB_POOL_MAX_CONNECTIONS=20

# ============================================
# Cache & Session (Production)
# ============================================
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# Redis Configuration (Production)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3

# Session Security
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict
SESSION_HTTP_ONLY=true

# ============================================
# Mail Configuration
# ============================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"

# ============================================
# File Storage & CDN
# ============================================
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=microweber-uploads
AWS_CDN_URL=https://cdn.your-domain.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================
# Payment Gateways (Production)
# ============================================
STRIPE_PUBLISHABLE_KEY=pk_live_
STRIPE_SECRET_KEY=sk_live_
STRIPE_WEBHOOK_SECRET=whsec_

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_TEST_MODE=false

# ============================================
# API & Authentication
# ============================================
SANCTUM_STATEFUL_DOMAINS=your-domain.com,admin.your-domain.com
API_RATE_LIMIT=60
API_RATE_LIMIT_PER_MINUTE=100

# ============================================
# Security (Production)
# ============================================
APP_FORCE_HTTPS=true
TRUSTED_PROXIES=*

# Content Security Policy
CSP_ENABLED=true
CSP_REPORT_ONLY=false

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ATTEMPTS=60
RATE_LIMIT_DECAY_MINUTES=1

# ============================================
# Performance & Caching
# ============================================
PAGE_CACHE_ENABLED=true
PAGE_CACHE_TTL=86400
PAGE_CACHE_DRIVER=redis
FRAGMENT_CACHE_ENABLED=true
FRAGMENT_CACHE_TTL=3600
FRAGMENT_CACHE_DRIVER=redis

# Cache Warming
PAGE_CACHE_WARMING=true
PAGE_CACHE_WARMING_SCHEDULE="0 2 * * *"

# ============================================
# Logging & Monitoring
# ============================================
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# Error Tracking (Sentry)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================
# Queue Workers
# ============================================
QUEUE_WORKER_MEMORY_LIMIT=512
QUEUE_WORKER_TIMEOUT=300
QUEUE_WORKER_SLEEP=3
QUEUE_WORKER_TRIES=3

# ============================================
# Media Library & CDN
# ============================================
MEDIA_LIBRARY_CDN_ENABLED=true
MEDIA_LIBRARY_CDN_URL=https://cdn.your-domain.com
MEDIA_LIBRARY_CDN_PROVIDER=aws

# Image Optimization
IMAGE_OPTIMIZATION_ENABLED=true
IMAGE_WEBP_CONVERSION=true
IMAGE_LAZY_LOADING=true

# ============================================
# Backup Configuration
# ============================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=30
BACKUP_DISK=s3
BACKUP_PATH=backups/

# ============================================
# AI Features (Production)
# ============================================
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_ENABLED=false

# ============================================
# Feature Flags
# ============================================
FEATURE_REGISTRATION=true
FEATURE_SOCIAL_LOGIN=true
FEATURE_NEWSLETTER=true
FEATURE_MARKETPLACE=false

# ============================================
# Maintenance Mode
# ============================================
# MAINTENANCE_MODE_SECRET=your-secret-key-for-bypass
