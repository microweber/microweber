+<?php
+
+declare(strict_types=1);
+
+namespace ViewStandalone\Tests;
+
+use MicroweberPackages\View\Contracts\ModuleProcessorInterface;
+use MicroweberPackages\View\StringBlade;
+use MicroweberPackages\View\Support\HtmlAttributes;
+use MicroweberPackages\View\TwigView;
+use MicroweberPackages\View\View;
+use MicroweberPackages\View\ViewServiceProvider;
+use Orchestra\Testbench\TestCase;
+
+/**
+ * Boots a bare Laravel app with only the view package
+ * (and optional format dependency) to prove the package works
+ * outside the Microweber CMS.
+ */
+class StandalonePackageTest extends TestCase
+{
+    /**
+     * @return list<class-string>
+     */
+    protected function getPackageProviders($app): array
+    {
+        $providers = [
+            ViewServiceProvider::class,
+        ];
+
+        if (class_exists(\MicroweberPackages\Format\FormatServiceProvider::class)) {
+            $providers[] = \MicroweberPackages\Format\FormatServiceProvider::class;
+        }
+        if (class_exists(\MicroweberPackages\Security\SecurityServiceProvider::class)) {
+            $providers[] = \MicroweberPackages\Security\SecurityServiceProvider::class;
+        }
+
+        return $providers;
+    }
+
+    protected function getEnvironmentSetUp($app): void
+    {
+        $app['config']->set('app.key', 'base64:' . base64_encode(random_bytes(32)));
+        $app['config']->set('database.default', 'testing');
+        $app['config']->set('database.connections.testing', [
+            'driver' => 'sqlite',
+            'database' => ':memory:',
+            'prefix' => '',
+        ]);
+        $app['config']->set('microweber-view.routes_enabled', true);
+        $app['config']->set('microweber-view.allow_render_endpoints', true);
+    }
+
+    public function test_services_resolve(): void
+    {
+        $this->assertInstanceOf(StringBlade::class, $this->app->make(StringBlade::class));
+        $this->assertInstanceOf(TwigView::class, $this->app->make(TwigView::class));
+        $this->assertInstanceOf(ModuleProcessorInterface::class, $this->app->make(ModuleProcessorInterface::class));
+    }
+
+    public function test_view_class_renders_file(): void
+    {
+        $file = sys_get_temp_dir() . '/mw_standalone_view_' . uniqid('', true) . '.php';
+        file_put_contents($file, 'Hello <?php echo $name; ?>');
+
+        try {
+            $view = new View($file);
+            $view->assign('name', 'Standalone');
+            $this->assertStringContainsString('Hello Standalone', (string) $view);
+        } finally {
+            @unlink($file);
+        }
+    }
+
+    public function test_string_blade_and_twig(): void
+    {
+        $blade = $this->app->make(StringBlade::class)->render('{{ $x }}', ['x' => 'B']);
+        $this->assertSame('B', trim($blade));
+
+        $twig = $this->app->make(TwigView::class)->render('{{ x }}', ['x' => 'T']);
+        $this->assertSame('T', $twig);
+    }
+
+    public function test_routes_registered(): void
+    {
+        $this->assertTrue($this->app->make('router')->has('microweber-view.health'));
+        $response = $this->get('/microweber-view/health');
+        $response->assertOk();
+        $response->assertJsonPath('status', 'ok');
+    }
+
+    public function test_demo_route(): void
+    {
+        $response = $this->get('/microweber-view/demo');
+        $response->assertOk();
+        $response->assertSee('StringBlade is working', false);
+    }
+
+    public function test_html_attributes(): void
+    {
+        $this->assertSame('a="1"', HtmlAttributes::toString(['a' => '1']));
+    }
+
+    public function test_sqlite_driver(): void
+    {
+        $this->assertEquals('sqlite', config('database.connections.testing.driver'));
+    }
+
+    public function test_format_dependency_when_available(): void
+    {
+        if (!class_exists(\MicroweberPackages\Format\Format::class)) {
+            $this->markTestSkipped('format package not present');
+        }
+        $this->assertTrue(class_exists(\MicroweberPackages\Format\Format::class));
+    }
+}
