@@ -0,0 +1,118 @@
+<?php
+
+declare(strict_types=1);
+
+namespace MicroweberPackages\View\Filament\Pages;
+
+use Filament\Forms\Components\Textarea;
+use Filament\Forms\Components\TextInput;
+use Filament\Notifications\Notification;
+use Filament\Pages\Page;
+use Filament\Schemas\Components\Section;
+use Filament\Schemas\Schema;
+use MicroweberPackages\View\StringBlade;
+use MicroweberPackages\View\TwigView;
+
+/**
+ * Simple Filament playground for StringBlade / TwigView rendering.
+ *
+ * @property \Filament\Schemas\Schema $form
+ */
+class ViewTools extends Page
+{
+    protected static string|\BackedEnum|null $navigationIcon = 'heroicon-o-code-bracket';
+
+    protected static string|\UnitEnum|null $navigationGroup = 'Developer';
+
+    protected static ?int $navigationSort = 90;
+
+    protected static ?string $title = 'View Tools';
+
+    protected static ?string $slug = 'microweber-view-tools';
+
+    protected string $view = 'microweber-view::filament.pages.view-tools';
+
+    /** @var array<string, mixed>|null */
+    public ?array $data = [];
+
+    public string $preview = '';
+
+    public static function shouldRegisterNavigation(): bool
+    {
+        return (bool) config('microweber-view.filament_enabled', true);
+    }
+
+    public function mount(): void
+    {
+        $this->form->fill([
+            'engine' => 'blade',
+            'template' => 'Hello {{ $name }}!',
+            'name' => 'World',
+        ]);
+    }
+
+    public function form(Schema $schema): Schema
+    {
+        return $schema
+            ->schema([
+                Section::make('Template playground')
+                    ->description('Render a Blade or Twig string using microweber-view.')
+                    ->schema([
+                        TextInput::make('engine')
+                            ->label('Engine (blade|twig)')
+                            ->default('blade')
+                            ->required(),
+                        Textarea::make('template')
+                            ->label('Template')
+                            ->rows(6)
+                            ->required(),
+                        TextInput::make('name')
+                            ->label('Sample variable: name')
+                            ->default('World'),
+                    ]),
+            ])
+            ->statePath('data');
+    }
+
+    public function renderPreview(): void
+    {
+        /** @var array<string, mixed> $state */
+        $state = $this->form->getState();
+        $engine = strtolower($this->asString($state['engine'] ?? 'blade'));
+        $template = $this->asString($state['template'] ?? '');
+        $name = $this->asString($state['name'] ?? 'World');
+
+        try {
+            if ($engine === 'twig') {
+                $this->preview = app(TwigView::class)->render($template, ['name' => $name]);
+            } else {
+                $this->preview = app(StringBlade::class)->render($template, ['name' => $name]);
+            }
+
+            Notification::make()
+                ->title('Rendered successfully')
+                ->success()
+                ->send();
+        } catch (\Throwable $e) {
+            $this->preview = '';
+            Notification::make()
+                ->title('Render failed')
+                ->body($e->getMessage())
+                ->danger()
+                ->send();
+        }
+    }
+
+    private function asString(mixed $value): string
+    {
+        if (is_string($value)) {
+            return $value;
+        }
+
+        if (is_scalar($value) || $value === null) {
+            return (string) $value;
+        }
+
+        return '';
+    }
+}
