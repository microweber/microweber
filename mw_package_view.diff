@@ -0,0 +1,94 @@
+<?php
+
+declare(strict_types=1);
+
+namespace MicroweberPackages\View\Tests\Dusk;
+
+use Tests\DuskTestCase;
+
+/**
+ * Dusk / browser smoke tests for microweber-view package routes.
+ *
+ * When a real Chrome/Chromium binary is available, exercises routes via
+ * the browser. Otherwise falls back to HTTP client smoke assertions so
+ * CI still validates the routes without a browser stack.
+ */
+class ViewRoutesDuskTest extends DuskTestCase
+{
+    protected function hasRealChromeBinary(): bool
+    {
+        $candidates = array_filter([
+            getenv('CHROME_PATH') ?: null,
+            '/usr/bin/google-chrome',
+            '/usr/bin/google-chrome-stable',
+            '/usr/bin/chromium',
+            '/snap/bin/chromium',
+            '/usr/bin/chromium-browser',
+        ]);
+
+        foreach ($candidates as $bin) {
+            if (!is_string($bin) || $bin === '' || !file_exists($bin)) {
+                continue;
+            }
+            if (is_link($bin)) {
+                $target = readlink($bin) ?: '';
+                if (str_contains($target, 'snap')) {
+                    continue;
+                }
+            }
+            $head = @file_get_contents($bin, false, null, 0, 200) ?: '';
+            if (str_contains($head, 'requires the chromium snap') || str_contains($head, 'snap install')) {
+                continue;
+            }
+            if (is_executable($bin)) {
+                return true;
+            }
+        }
+
+        return false;
+    }
+
+    protected function httpSmoke(string $path, int|array $expectedStatus, ?string $see = null): void
+    {
+        $statuses = is_array($expectedStatus) ? $expectedStatus : [$expectedStatus];
+
+        $response = $this->get($path);
+        $this->assertContains(
+            $response->status(),
+            $statuses,
+            "GET {$path} returned {$response->status()}"
+        );
+
+        if ($see !== null) {
+            $response->assertSee($see, false);
+        }
+    }
+
+    public function test_health_route_smoke(): void
+    {
+        if ($this->hasRealChromeBinary()) {
+            $this->browse(function ($browser): void {
+                $browser->visit('/microweber-view/health')
+                    ->assertSee('ok');
+            });
+
+            return;
+        }
+
+        $this->httpSmoke('/microweber-view/health', 200, 'ok');
+    }
+
+    public function test_demo_route_smoke(): void
+    {
+        if ($this->hasRealChromeBinary()) {
+            $this->browse(function ($browser): void {
+                $browser->visit('/microweber-view/demo')
+                    ->assertSee('StringBlade is working');
+            });
+
+            return;
+        }
+
+        $this->httpSmoke('/microweber-view/demo', 200, 'StringBlade is working');
+    }
+}
