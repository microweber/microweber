diff --git a/packages/microweber-view/src/Http/Controllers/ViewPackageController.php b/packages/microweber-view/src/Http/Controllers/ViewPackageController.php
new file mode 100644
index 0000000..19af536
--- /dev/null
+++ b/packages/microweber-view/src/Http/Controllers/ViewPackageController.php
@@ -0,0 +1,121 @@
+<?php
+
+declare(strict_types=1);
+
+namespace MicroweberPackages\View\Http\Controllers;
+
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Illuminate\Http\Response;
+use Illuminate\Routing\Controller;
+use MicroweberPackages\View\StringBlade;
+use MicroweberPackages\View\TwigView;
+use MicroweberPackages\View\View;
+
+class ViewPackageController extends Controller
+{
+    /**
+     * Package health / status endpoint.
+     */
+    public function health(): JsonResponse
+    {
+        return response()->json([
+            'package' => 'microweber-packages/view',
+            'status' => 'ok',
+            'classes' => [
+                'View' => class_exists(View::class),
+                'StringBlade' => class_exists(StringBlade::class),
+                'TwigView' => class_exists(TwigView::class),
+            ],
+            'config' => [
+                'routes_enabled' => (bool) config('microweber-view.routes_enabled', true),
+                'module_directive_enabled' => (bool) config('microweber-view.module_directive_enabled', true),
+                'allow_render_endpoints' => (bool) config('microweber-view.allow_render_endpoints', false),
+            ],
+        ]);
+    }
+
+    /**
+     * Simple demo page that renders a fixed fixture via StringBlade.
+     */
+    public function demo(StringBlade $stringBlade): Response
+    {
+        $html = $stringBlade->render(
+            '<!DOCTYPE html><html><head><title>microweber-view demo</title></head>'
+            . '<body><h1>{{ $title }}</h1><p>{{ $message }}</p></body></html>',
+            [
+                'title' => 'microweber-view',
+                'message' => 'StringBlade is working.',
+            ]
+        );
+
+        return response($html, 200)->header('Content-Type', 'text/html; charset=UTF-8');
+    }
+
+    /**
+     * Optional Blade string render endpoint (disabled by default).
+     */
+    public function renderBlade(Request $request, StringBlade $stringBlade): JsonResponse|Response
+    {
+        if (!(bool) config('microweber-view.allow_render_endpoints', false)) {
+            return response()->json(['error' => 'Render endpoints disabled'], 403);
+        }
+
+        $template = $this->stringInput($request, 'template');
+        /** @var array<string, mixed> $data */
+        $data = (array) $request->input('data', []);
+
+        if ($template === '') {
+            return response()->json(['error' => 'template is required'], 422);
+        }
+
+        $html = $stringBlade->render($template, $data);
+
+        if ($request->wantsJson()) {
+            return response()->json(['html' => $html]);
+        }
+
+        return response($html, 200)->header('Content-Type', 'text/html; charset=UTF-8');
+    }
+
+    /**
+     * Optional Twig string render endpoint (disabled by default).
+     */
+    public function renderTwig(Request $request, TwigView $twigView): JsonResponse|Response
+    {
+        if (!(bool) config('microweber-view.allow_render_endpoints', false)) {
+            return response()->json(['error' => 'Render endpoints disabled'], 403);
+        }
+
+        $template = $this->stringInput($request, 'template');
+        /** @var array<string, mixed> $data */
+        $data = (array) $request->input('data', []);
+
+        if ($template === '') {
+            return response()->json(['error' => 'template is required'], 422);
+        }
+
+        $html = $twigView->render($template, $data);
+
+        if ($request->wantsJson()) {
+            return response()->json(['html' => $html]);
+        }
+
+        return response($html, 200)->header('Content-Type', 'text/html; charset=UTF-8');
+    }
+
+    private function stringInput(Request $request, string $key): string
+    {
+        $value = $request->input($key, '');
+
+        if (is_string($value)) {
+            return $value;
+        }
+
+        if (is_scalar($value)) {
+            return (string) $value;
+        }
+
+        return '';
+    }
+}
